{
  "name": "network.networking.datumapis.com",
  "version": "0.1.0",
  "sdk": { "name": "@datum-cloud/portal-plugin-sdk", "range": "^1.0.0" },
  "remoteEntry": "remoteEntry.js",
  "exposedModules": {
    "NetworkList": "./src/pages/network-list.tsx",
    "NetworkDetail": "./src/pages/network-detail.tsx",
    "NetworkHomeHero": "./src/components/network-home-hero.tsx",
    "CreateNetworkDialog": "./src/components/create-network-dialog.tsx",
    "NlbList": "./src/pages/nlb-list.tsx"
  },
  "extensions": [
    {
      "type": "portal.nav/project",
      "properties": {
        "id": "networks",
        "title": "VPC",
        "icon": "network",
        "path": "networks",
        "order": 10,
        "section": "connect"
      }
    },
    {
      "type": "portal.page/project",
      "properties": {
        "path": "networks",
        "component": { "$codeRef": "NetworkList" }
      },
      "requirements": {
        "permissions": [
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "list" },
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "create" }
        ]
      }
    },
    {
      "type": "portal.page/project",
      "properties": {
        "path": "networks/:networkName/*",
        "component": { "$codeRef": "NetworkDetail" }
      },
      "requirements": {
        "permissions": [
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "get" },
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "update" },
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "delete" },
          { "group": "networking.datumapis.com", "resource": "networkservices", "verb": "list" },
          { "group": "networking.datumapis.com", "resource": "networkservices", "verb": "create" },
          { "group": "networking.datumapis.com", "resource": "networkservices", "verb": "delete" }
        ]
      }
    },
    {
      "type": "portal.nav/project",
      "properties": {
        "id": "nlb",
        "title": "NLB",
        "icon": "network",
        "path": "nlb",
        "order": 35,
        "section": "deliver"
      }
    },
    {
      "type": "portal.page/project",
      "properties": {
        "path": "nlb",
        "component": { "$codeRef": "NlbList" }
      },
      "requirements": {
        "permissions": [
          { "group": "networking.datumapis.com", "resource": "networkloadbalancers", "verb": "list" }
        ]
      }
    },
    {
      "type": "portal.hero/project-home",
      "properties": {
        "title": "Create your network",
        "component": { "$codeRef": "NetworkHomeHero" },
        "order": 10
      },
      "requirements": {
        "permissions": [
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "list" },
          { "group": "networking.datumapis.com", "resource": "networks", "verb": "create" }
        ]
      }
    }
  ]
}
